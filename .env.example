# Ravensight — Docker environment configuration
#
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.
#
#   cp .env.example .env

# --- Container user (required) ---
# The uid/gid Ravensight runs as inside the container, so files in data/ and
# reports/ end up owned by you on the host.
#   Normal Docker on Linux:     run `id -u` and `id -g` on the host
#   Rootless Docker / Podman:   set both to 0 (container root is already you)
#   Docker Desktop (macOS/Win): `id -u` / `id -g` is fine
RAVENSIGHT_PUID=
RAVENSIGHT_PGID=

# --- Wazuh (required) ---
# The Wazuh manager API login is no longer used. Old WAZUH_API_USER,
# WAZUH_API_PASSWORD and WAZUH_PORT entries can be deleted but are harmless.
WAZUH_HOST=

# --- Wazuh Indexer / OpenSearch (required) ---
WAZUH_INDEXER_HOST=
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
# Optional TLS verification for the Indexer (config keys indexer_verify_tls and
# indexer_ca_path in [wazuh]).
# WAZUH_INDEXER_VERIFY_TLS: default false (no verification). Must be exactly true or
# false, lowercase, no quotes.
# WAZUH_INDEXER_CA_PATH: default empty. In Docker this is the path INSIDE the container,
# e.g. /app/data/wazuh-ca.pem, and the file must live in the mounted data folder.
# A set CA path wins over WAZUH_INDEXER_VERIFY_TLS=false.
# Verification also checks the hostname: a self-signed certificate must include the
# indexer host name or IP in its SAN, or the request fails with an SSL error (logged
# as "Failed to connect to Wazuh Indexer").
WAZUH_INDEXER_VERIFY_TLS=false
WAZUH_INDEXER_CA_PATH=

# --- LLM (required) ---
# e.g. http://yubaba:8080/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=local
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Embeddings (required) ---
# e.g. http://yubaba:8081/v1
EMBEDDINGS_ENDPOINT=
EMBEDDINGS_MODEL=Qwen3-Embedding-0.6B
EMBEDDINGS_TOP_K=5

# --- Chroma (optional, only relevant with --profile chroma) ---
# Set EMBEDDINGS_CHROMA_HOST=chroma to point Ravensight at the bundled Chroma
# service started via `docker compose --profile chroma up -d chroma`.
# Leave EMBEDDINGS_CHROMA_HOST empty (default) to keep today's embedded mode
# unchanged — Ravensight creates its own data/chroma/embedded directory inside
# the container and ignores this section entirely.
# EMBEDDINGS_CHROMA_PORT is the in-network client dial port (must stay 8000 to match the image).
# RAVENSIGHT_CHROMA_PORT is the host-published port (change if 8000 conflicts on this host).
EMBEDDINGS_CHROMA_HOST=
EMBEDDINGS_CHROMA_PORT=8000
RAVENSIGHT_HOST_CHROMA_PATH=./data/chroma/server
RAVENSIGHT_CHROMA_PORT=8000

# --- Trending (optional) ---
TRENDING_WINDOW_DAYS=30
TRENDING_MAX_ROWS=25

# --- Paths inside the container (optional — rarely need to change) ---
RAVENSIGHT_DATA_DIR=/app/data
RAVENSIGHT_REPORTS_DIR=/app/reports

# --- Reports (optional) ---
# false (default): reports/<date>/security_report_<time>.md, reruns never overwrite.
# true: reports/<date>_security_report.md, overwritten by later runs the same day.
# Must be exactly true or false, lowercase, no quotes.
RAVENSIGHT_REPORTS_OVERWRITE=false

# --- Time zone (optional) ---
# IANA time zone name, e.g. Australia/Adelaide. Set it to the time zone of any
# host-side runs so Docker and host-side runs agree. Without it the container
# uses UTC. It decides the local day for Trends, report folders and file names,
# and the "Generated" time.
# Set it once and leave it: changing it on a container with existing history
# makes old entries read as the new local time. An empty `TZ=` silently stays UTC,
# so leave the line commented out unless you have a value.
# TZ=Australia/Adelaide

# --- Essential Eight attestations (optional, no variable needed) ---
# If data/e8_attestation.json exists it is picked up automatically on start.
# Create it from the example with:
#   docker run --env-file .env -v ./data:/app/data ravensight init-attestation

# --- Host-side bind mount paths (used by docker-compose.yml) ---
# Where data/ and reports/ actually live on this machine.
# Defaults to ./data and ./reports (relative to the repo) if unset.
RAVENSIGHT_HOST_DATA_PATH=./data
RAVENSIGHT_HOST_REPORTS_PATH=./reports
