{
  "mcpServers": {
    "graft": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@nanonets/graft", "mcp"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
