{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run pyright *)",
      "Bash(uv run python -m py_compile *)",
      "Bash(graft map *)",
      "Bash(graft ask *)",
      "Bash(graft grep *)",
      "Bash(graft skeleton *)",
      "Bash(graft callers *)",
      "Bash(graft build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git --no-pager diff *)",
      "Bash(git log *)",
      "Bash(git --no-pager log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(mkdir -p .session-memos)",
      "Bash(date *)",
      "mcp__graft",
      "mcp__claude-in-chrome",
      "Edit(/docs/RAVENSIGHT_ROADMAP.md)",
      "Edit(/docs/roadmap-archive.md)"
    ],
    "ask": [
      "Bash(uv run python -c *)",
      "Bash(git branch -D *)",
      "Bash(git switch --discard-changes *)"
    ],
    "deny": [
      "Read(config.toml)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(config.toml)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.mcp.json)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Bash(git push *)",
      "Bash(git * --force*)",
      "Bash(git * -f)",
      "Bash(git * -f *)",
      "Bash(git reset --hard *)",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__upload_image",
      "mcp__claude-in-chrome__shortcuts_execute"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Artifact|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}